# Copy to .env (never committed) to override the development defaults of docker-compose.yml.

# Operator sign-in of the Lab
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=change-me

# Token signing keys (long random strings). The Review service verifies the Lab's operator tokens,
# so both services get the same LAB_JWT_SECRET.
LAB_JWT_SECRET=change-me-to-a-long-random-string
REVIEW_JWT_SECRET=change-me-to-another-long-random-string

# Infrastructure passwords
POSTGRES_PASSWORD=change-me
LAB_DB_PASSWORD=change-me
REVIEW_DB_PASSWORD=change-me
RABBITMQ_USER=edugen
RABBITMQ_PASSWORD=change-me

# Optional: live language models (paid). Without keys only the offline simulator is available.
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=

# Pause of the offline simulator per call, so the live progress is visible in demos
SIMULATOR_DELAY_SECONDS=1.5
